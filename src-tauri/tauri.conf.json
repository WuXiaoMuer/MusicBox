{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MusicBox",
  "version": "0.1.0",
  "identifier": "com.example.musicbox",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MusicBox",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560
      },
      {
        "label": "mini",
        "title": "MusicBox",
        "url": "mini.html",
        "width": 400,
        "height": 96,
        "visible": false,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/**/*",
          "$AUDIO/**/*",
          "$DOWNLOAD/**/*",
          "$DESKTOP/**/*",
          "$DOCUMENT/**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
